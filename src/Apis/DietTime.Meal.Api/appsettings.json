{
  "DeliverySchedule": {
    "ActiveWeekdays": [ "SATURDAY", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY" ]
  },
  "CustomerNutrition": {
    "MinimumDailyCaloriesKcal": 1200,
    "ProteinGramsPerKg": 1.6,
    "FatCaloriesRatio": 0.30,
    "FiberGramsPerThousandCalories": 14,
    "WaterMlPerKg": 35,
    "ActivityMultipliers": {
      "MOSTLY_SITTING": 1.20,
      "LIGHT_ACTIVITY": 1.375,
      "ACTIVE_LIFESTYLE": 1.55,
      "VERY_ACTIVE": 1.725,
      "ATHLETE": 1.90
    },
    "GoalAdjustmentsKcal": {
      "LOSE_WEIGHT": -500,
      "MAINTAIN_WEIGHT": 0,
      "GAIN_WEIGHT": 300,
      "BUILD_MUSCLE": 250,
      "EAT_HEALTHIER": 0
    }
  },
  "GuestProfile": {
    "TokenExpiryDays": 30,
    "TokenLengthBytes": 32,
    "HashAlgorithm": "SHA256",
    "ExpiredProfileRetentionDays": 7,
    "CleanupIntervalHours": 24,
    "CleanupBatchSize": 500
  },
  "AllowedHosts": "*",
  "Jwt": { "Issuer": "", "Audience": "", "Key": "", "AccessTokenMinutes": 15, "RefreshTokenDays": 30 },
  "Api": { "PublicBaseUrl": "" },
  "Storage": { "ServiceUrl": "", "PublicBaseUrl": "", "BucketName": "", "AccessKey": "", "SecretKey": "", "Region": "auto", "MaxUploadSizeBytes": 10485760 },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console" } ]
  }
}
