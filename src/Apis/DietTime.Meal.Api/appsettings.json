{
  "DeliverySchedule": {
    "ActiveWeekdays": [ "SATURDAY", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY" ]
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "DietTime.Api",
    "Audience": "DietTime.App",
    "Key": "your-secret-key-change-this-in-production-minimum-32-characters",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "PasswordReset": {
    "ExpiryHours": 24,
    "ResetLinkTemplate": "https://localhost:5173/auth/set-password?token={0}"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromEmail": "noreply@diettime.app",
    "FromName": "DietTime",
    "Username": "",
    "Password": "",
    "UseSsl": true
  },
  "Api": { "PublicBaseUrl": "" },
  "Storage": { "ServiceUrl": "", "PublicBaseUrl": "", "BucketName": "", "AccessKey": "", "SecretKey": "", "Region": "auto", "MaxUploadSizeBytes": 10485760 },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console" } ]
  }
}

