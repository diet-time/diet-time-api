{
  "DeliverySchedule": {
    "ActiveWeekdays": [ "SATURDAY", "SUNDAY", "MONDAY", "TUESDAY", "WEDNESDAY", "THURSDAY" ]
  },
  "CustomerNutrition": {
    "MinimumDailyCaloriesKcal": 1200,
    "ProteinGramsPerKg": 1.6,
    "FatCaloriesRatio": 0.30,
    "FiberGramsPerThousandCalories": 14,
    "WaterMlPerKg": 35,
    "ActivityMultipliers": {
      "MOSTLY_SITTING": 1.20,
      "LIGHT_ACTIVITY": 1.375,
      "ACTIVE_LIFESTYLE": 1.55,
      "VERY_ACTIVE": 1.725,
      "ATHLETE": 1.90
    },
    "GoalAdjustmentsKcal": {
      "LOSE_WEIGHT": -500,
      "MAINTAIN_WEIGHT": 0,
      "GAIN_WEIGHT": 300,
      "BUILD_MUSCLE": 250,
      "EAT_HEALTHIER": 0
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "DietTime.Api",
    "Audience": "DietTime.App",
    "Key": "your-secret-key-change-this-in-production-minimum-32-characters",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 3650
  },
  "PhoneOtp": {
    "Enabled": false,
    "TestCode": ""
  },
  "PasswordReset": {
    "ExpiryHours": 24,
    "ResetLinkTemplate": "https://localhost:5173/auth/set-password?token={0}"
  },
  "Smtp": {
    "Host": "smtp.gmail.com",
    "Port": 587,
    "FromEmail": "noreply@diettime.app",
    "FromName": "DietTime",
    "Username": "",
    "Password": "",
    "UseSsl": true
  },
  "Api": { "PublicBaseUrl": "" },
  "Storage": { "ServiceUrl": "", "PublicBaseUrl": "", "BucketName": "", "AccessKey": "", "SecretKey": "", "Region": "auto", "MaxUploadSizeBytes": 10485760 },
  "Cors": { "AllowedOrigins": [] },
  "Serilog": {
    "MinimumLevel": { "Default": "Information", "Override": { "Microsoft.AspNetCore": "Warning", "Microsoft.EntityFrameworkCore.Database.Command": "Warning" } },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [ { "Name": "Console" } ]
  }
}

